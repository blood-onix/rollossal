# Wally packages (restored with `wally install`; wally.lock stays committed)
/Packages/*
!/Packages/.gitkeep
/ServerPackages/
/DevPackages/

# Rojo / Roblox build output
sourcemap.json
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx
*.rbxl.lock
*.rbxlx.lock

# Blender backups and render output (keep art/source/*.blend and art/export/*.fbx)
*.blend1
*.blend2
/art/render/
/art/qa/*
!/art/qa/grid.png
!/art/qa/theme_grid.png
__pycache__/

# Local tool state
.claude/settings.local.json
.claude/worktrees/
.opencode/node_modules/
node_modules/
.env
.env.*

# Editors and OS
.vscode/*
!.vscode/mcp.json
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
*.log

# Secrets
*.pem
*.key

# Selene Roblox standard (generated by `selene generate-roblox-std`)
roblox.yml

# Downloaded luau-lsp Roblox type definitions (scripts/check.sh)
.cache/
