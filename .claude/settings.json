{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/studio-preflight.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(osascript:*)",
      "Bash(*osascript *)",
      "Bash(open -a:*)",
      "Bash(cliclick:*)"
    ]
  }
}
