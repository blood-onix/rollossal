{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Roblox_Studio": {
      "type": "local",
      "command": [
        "/Applications/RobloxStudio.app/Contents/MacOS/StudioMCP"
      ],
      "enabled": true
    },
    "blender": {
      "type": "local",
      "command": ["/opt/homebrew/bin/uvx", "mcp-for-blender"],
      "enabled": true
    }
  }
}
