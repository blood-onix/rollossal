--!strict
-- The six season themes. Data only: no Roblox APIs and no requires, so Lune and the game load it the
-- same way (specs/005-theme-art-pipeline/data-model.md §1, contracts/theme-content.md §1).
-- The palette block between BEGIN/END GENERATED PALETTES is written by `python3 scripts/design-tokens.py`
-- from docs/design/tokens.json; nothing else in this file is generated. A ThemeDef owns the *look*
-- (palette, lighting, weather, music); a world binds its own slots and overlays per theme
-- (Content/GreyBoxRoom.luau ThemeBinding).

-- Lighting. Same shape as Content/GreyBoxRoom.luau LightingDef (spelled out here: Content modules
-- cannot require each other).
-- Colour grading (one ColorCorrectionEffect in Lighting). tint is RGB 0..255.
export type GradingDef = {
	brightness: number,
	contrast: number,
	saturation: number,
	tint: { number },
}

export type LightingDef = {
	ambient: { number },
	outdoorAmbient: { number },
	brightness: number,
	clockTime: number,
	fogColor: { number },
	fogStart: number,
	fogEnd: number,
	atmosphereDensity: number,
	atmosphereColor: { number },
	atmosphereDecay: { number },
	-- Optional (013 tween-appeal rework, style bible section 8): applied by WorldBuilder.applyLighting when set.
	shadowSoftness: number?,
	geographicLatitude: number?,
	grading: GradingDef?,
}

export type WeatherDef = {
	kind: "snow" | "petals" | "leaves" | "sparkle" | "none",
	rate: number,
	maxParticles: number,
	lifetime: number,
	color: { number },
	size: number,
	speed: number,
}

export type ThemeDef = {
	id: string,
	nameKey: string,
	-- Key in Assets.palettes; the key equals the theme id.
	paletteAssetKey: string,
	palette: { [string]: { number } },
	lighting: LightingDef,
	weather: WeatherDef,
	musicAssetKey: string,
}

-- Theme ids in tokens.json order: used by tests, the QA grid and the Book's page order.

