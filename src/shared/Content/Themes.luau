-- Lighting colours derive from the palette light-* cells; the scalars are hand-authored per theme.
local function lighting(
	palette: { [string]: { number } },
	brightness: number,
	clockTime: number,
	fogStart: number,
	fogEnd: number,
	atmosphereDensity: number
): LightingDef
	return {
		ambient = palette["light-ambient"],
		outdoorAmbient = palette["light-sky"],
		brightness = brightness,
		clockTime = clockTime,
		fogColor = palette["light-fog"],
		fogStart = fogStart,
		fogEnd = fogEnd,
		atmosphereDensity = atmosphereDensity,
		atmosphereColor = palette["light-sky"],
		atmosphereDecay = palette["light-fog"],
	}
end

