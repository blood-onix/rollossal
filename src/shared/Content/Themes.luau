-- Lighting colours derive from the palette light-* cells; the scalars are hand-authored per theme.
local function lighting(
	palette: { [string]: { number } },
	brightness: number,
	clockTime: number,
	fogStart: number,
	fogEnd: number,
	atmosphereDensity: number,
	extra: {
		shadowSoftness: number,
		geographicLatitude: number,
		grading: GradingDef,
	}?
): LightingDef
	return {
		shadowSoftness = if extra then extra.shadowSoftness else nil,
		geographicLatitude = if extra then extra.geographicLatitude else nil,
		grading = if extra then extra.grading else nil,
		ambient = palette["light-ambient"],
