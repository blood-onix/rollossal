--!strict
-- Starts the server services in order, then drives the per-Heartbeat room and ball updates.

local RunService = game:GetService("RunService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

require(script.Parent.Remotes)
local WorldSpawner = require(script.Parent.WorldSpawner)
local BallService = require(script.Parent.BallService)
local AbsorbService = require(script.Parent.AbsorbService)
local FriendCache = require(script.Parent.FriendCache)
local RunManager = require(script.Parent.RunManager)
local BoosterService = require(script.Parent.BoosterService)
local HazardService = require(script.Parent.HazardService)
local ToyService = require(script.Parent.ToyService)
local SliceWalls = require(script.Parent.SliceWalls)
local BotService = require(script.Parent.BotService)
local FeastService = require(script.Parent.FeastService)
local MeteorService = require(script.Parent.MeteorService)
local FlowService = require(script.Parent.FlowService)
local LaunchRamps = require(script.Parent.LaunchRamps)
local MapEvents = require(script.Parent.MapEvents)

if Config.Flags.Saving then
	local DataService = require(script.Parent.DataService)
	DataService.start()
end

WorldSpawner.start()
WorldSpawner.setWatcherSource(BallService.watchers)
FriendCache.start()
BallService.start()
AbsorbService.start()
RunManager.start()
BoosterService.start()
HazardService.start()
ToyService.start()
SliceWalls.start()
BotService.start()
MeteorService.start()
FlowService.start()
LaunchRamps.start()
MapEvents.start()

RunService.Heartbeat:Connect(function(dt: number)
	local now = os.clock()
	WorldSpawner.update(now)
	AbsorbService.stepLight(now)
	BallService.step(now, dt)
	RunManager.step(now)
	BoosterService.step(now, dt)
	HazardService.step(now, dt)
	ToyService.step(now)
	BotService.step(now)
	FeastService.step(now)
	MeteorService.step(now)
	FlowService.step(now)
	LaunchRamps.step(now)
	MapEvents.step(now)
end)
